{
  "name": "@sourceloop/ai-assistant",
  "version": "0.0.0",
  "description": "Library for providing Ai chatbot with server sent events.",
  "keywords": [
    "angular-library"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "echo \"No tests available !\"",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI --code-coverage",
    "build-library": "ng build ai-assistant",
    "pack-lib": "cd projects/ai-assistant-lib/dist && npm pack",
    "lint": "ng lint",
    "prettier:cli": "prettier \"**/*.ts\" \"**/*.js\" \"**/*.html\"",
    "prettier:check": "npm run prettier:cli -- --check",
    "prettier:fix": "npm run prettier:cli -- --write"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sourcefuse/arc-ng-components",
    "directory": "packages/ai-assistant"
  },
  "author": "Sourcefuse",
  "license": "MIT",
  "private": false,
  "dependencies": {
    "@angular-eslint/builder": "^22.8.0",
    "@angular-eslint/eslint-plugin": "^22.8.0",
    "@angular-eslint/eslint-plugin-template": "^22.8.0",
    "@angular-eslint/schematics": "^22.8.0",
    "@angular-eslint/template-parser": "^22.8.0",
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/elements": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "deep-chat": "^1.4.11",
    "extended-eventsource": "^1.4.9",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.15.0"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jasmine": "~3.8.0",
    "@types/node": "18.7.8",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^6.9.2",
    "cz-customizable-ghooks": "^2.0.0",
    "eslint": "^9.39.0",
    "husky": "^8.0.3",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^22.2.6",
